<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Transparent theme for the Siri-style assistant overlay -->
    <style name="DigitalLiquidAssistantTheme"
        parent="@android:style/Theme.Material.NoActionBar">

        <!-- Accent -->
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D6A463</item>

        <!-- Transparent assistant window -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">
            @android:color/transparent
        </item>

        <!-- Full-screen overlay -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:backgroundDimAmount">0.0</item>
        <item name="android:backgroundDimEnabled">false</item>

        <!-- Transparent system bars -->
        <item name="android:statusBarColor">
            @android:color/transparent
        </item>
        <item name="android:navigationBarColor">
            @android:color/transparent
        </item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

</resources>
